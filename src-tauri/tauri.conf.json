{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Questlog",
  "version": "0.3.4",
  "identifier": "com.questlog.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "backgroundThrottling": "disabled"
      },
      {
        "label": "overlay",
        "title": "",
        "url": "/",
        "width": 384,
        "height": 104,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "focus": false,
        "shadow": false,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**", "$APPLOCALDATA/**", "$RESOURCE/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["questlog"],
        "name": "Questlog Guide",
        "description": "Guia Questlog",
        "role": "Editor",
        "mimeType": "application/x-questlog+json"
      }
    ],
    "resources": [
      "resources/questlog-file.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./windows/nsis-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM1RjI0NURDRTQzNEI0OTUKUldTVnREVGszRVh5Tlp5czh3QVhFUDQ3K1BBOWxTUWJlYThkamwzaW8xeXlWQlVnODBRZzFRUisK",
      "endpoints": [
        "https://github.com/Cleber-Sanches/Questlog/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
