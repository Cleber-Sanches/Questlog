{
  "name": "questlog",
  "private": true,
  "version": "0.3.5",
  "type": "module",
  "description": "Questlog — guia local de conquistas Steam (Tauri + React + SQLite)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:signed": "powershell -ExecutionPolicy Bypass -File tools/build-release.ps1",
    "tauri:sign": "powershell -ExecutionPolicy Bypass -File tools/sign-installer.ps1",
    "update:manifest": "node tools/write-latest-json.mjs",
    "start:legacy": "node tools/server.js",
    "build:exe:legacy": "node tools/build-portable.js",
    "build:installer:legacy": "node tools/build-installer.js"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.3",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-fs": "^2.4.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "country-flag-icons": "^1.6.20",
    "motion": "^13.1.0",
    "quill": "^2.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-quill-new": "^3.8.3",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@yao-pkg/pkg": "^6.6.0",
    "oxlint": "^1.75.0",
    "typescript": "~5.9.3",
    "vite": "^8.2.0"
  }
}
